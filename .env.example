# Copy to .env (gitignored) and change the values. Never commit .env.
# docker compose reads these for the database container.

POSTGRES_USER=askanddo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=askanddo
POSTGRES_PORT=5432

# Used by prepare/ and runtime/ to connect. Keep it in sync with the values above.
DATABASE_URL=postgresql://askanddo:change-me@localhost:5432/askanddo

# Embedding model, used by both ingest and search (they must match).
# Changing it means re-ingesting with --reset, since the vector size can change.
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Optional text put in front of search queries only. Empty by default.
EMBED_QUERY_PREFIX=
# Where downloaded model files are kept (gitignored).
EMBED_CACHE_DIR=.cache/fastembed

# Not-found gate: search returns nothing below this cosine similarity.
# Specific to the embedding model, so re-tune it if EMBED_MODEL changes.
SEARCH_MIN_SCORE=0.70
